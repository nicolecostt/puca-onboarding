{
  "name": "puca-onboarding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "description": "Orbis: Puca conduz o onboarding por voz",
  "author": "Orbis",
  "scripts": {
    "dev": "vite",
    "dev:fly": "API_TARGET=https://orbis-puca.fly.dev vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "bench:llm": "tsx server/bench/llm-latency.ts",
    "bench:turn": "tsx server/bench/turn-latency.ts",
    "precompute": "tsx server/scripts/precompute.ts",
    "dev:server": "tsx watch server/src/server.ts",
    "start": "tsx server/src/server.ts",
    "build:desktop": "esbuild desktop/main.ts desktop/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outdir=dist-desktop --out-extension:.js=.cjs",
    "dev:app": "npm run build:desktop && ORBIS_DEV_URL=http://localhost:5173 electron .",
    "build:app": "VITE_API_URL=https://orbis-puca.fly.dev npm run build && npm run build:desktop && electron-builder --config desktop/electron-builder.yml --mac zip --arm64 --x64 && sh scripts/somas-sha256.sh",
    "publicar-app": "bash scripts/publicar-app.sh",
    "check": "npm run typecheck && npm test && npm run check:contexto && npm run check:harness && vite build",
    "check:contexto": "tsx scripts/check-contexto.ts",
    "check:harness": "tsx scripts/check-harness.ts",
    "kota:codeowners": "tsx kit/kota/gerar/codeowners.ts",
    "kota:readmes": "tsx kit/kota/gerar/readme-servico.ts",
    "kota:slack": "tsx kit/kota/slack/preencher.ts",
    "check:kota": "tsx kit/kota/checar/cli.ts",
    "kota:marca": "tsx kit/kota/marca/cli.ts",
    "kota:readme-raiz": "tsx kit/kota/gerar/readme-raiz.ts",
    "kota:tarefas": "tsx kit/kota/tarefas/publicar.ts",
    "kota:publicar": "tsx kit/kota/historia/publicar.ts",
    "contas-demo": "tsx server/scripts/contas-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@supabase/supabase-js": "^2.119.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "three": "^0.169.0",
    "ws": "^8.22.1"
  }
}
